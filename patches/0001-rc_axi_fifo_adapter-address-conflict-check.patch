From d1fa34025ab064488ca1d0ffa49bcd217c39b9da Mon Sep 17 00:00:00 2001
From: x <x>
Date: Thu, 26 Nov 2026 11:48:56 -0800
Subject: [PATCH] rc_axi_fifo_adapter: address-conflict check instead of
 direction barrier

Replace the read/write direction barrier (a command of the other direction
waited until every in-flight command of the current direction had completed)
with a per-line hazard check. The mig_caf head command is held only while its
32-byte line index addr[WIN_AW-4:2] matches an in-flight command of the
opposite direction:
  read after write:  AR waits for that write's BRESP
  write after read:  AW waits for that read's RLAST
Tags (up to MAX_WR_OUT / MAX_RD_OUT) are allocated at issue and freed by the
in-order B / RLAST. Still 8 writes + 8 reads outstanding, command order from
mig_caf, one-cycle rdf_wren pop pulse, async FIFOs and the `idle` semantics
are unchanged.

Sim: new sim/axi4_slave_rand.v (reads sample memory at burst start, writes
commit when B is presented, random latencies: R/W effects may be reordered
as HP0 may legally do) and sim/tb_adapter_mixed.v (RequestController + a
data-port reader/writer + pixf streaming reader, checked against a
command-order reference memory). make simmix (20 random runs) and make
simthru (throughput) added; make sim now includes simmix. README updated.
---
 06_request_controller_arb_test/Makefile       |  41 +-
 06_request_controller_arb_test/README.md      |  28 +-
 .../rtl/rc_axi_fifo_adapter.v                 |  75 +++-
 .../sim/axi4_slave_rand.v                     | 185 +++++++++
 .../sim/tb_adapter_mixed.v                    | 377 ++++++++++++++++++
 5 files changed, 692 insertions(+), 14 deletions(-)
 create mode 100644 06_request_controller_arb_test/sim/axi4_slave_rand.v
 create mode 100644 06_request_controller_arb_test/sim/tb_adapter_mixed.v

diff --git a/06_request_controller_arb_test/Makefile b/06_request_controller_arb_test/Makefile
index 756bfb1..c4826a4 100644
--- a/06_request_controller_arb_test/Makefile
+++ b/06_request_controller_arb_test/Makefile
@@ -24,19 +24,20 @@ REF_SRCS := rtl/rc_ddr_test.v rtl/RequestController.v rtl/dcache_tester.v \
 
 VIVADO_BAT := $(VIVADO) -mode batch -notrace -nojournal
 
-.PHONY: all help sim sim16 sim64 simref overlay clean
+.PHONY: all help sim sim16 sim64 simref simmix simthru overlay clean
 
 all: sim
 
 help:
 	@echo "06_request_controller_arb_test  (UART char -> fake dcache -> RequestController -> mig_* FIFOs -> AXI4 HP0)"
 	@echo "  make sim      Icarus: 16 KiB (512 lines) and 64 KiB (2048 lines) runs"
+	@echo "  make simmix   mixed R/W hazard test (random latencies, 20 runs); simthru: throughput"
 	@echo "  make simref   same tests on 05's register-only adapter (A/B numbers)"
 	@echo "  make overlay  Vivado 2019.1 PS7+SmartConnect bitstream + hwh"
 	@echo "                (../build/rc_arb_test/). Does NOT program a board."
 	@echo "  make clean    remove sim products"
 
-sim: sim16 sim64
+sim: sim16 sim64 simmix
 
 sim16: $(SIM_SRCS)
 	iverilog -g2005 -o sim/tb16.vvp -s $(SIM_TOP) -P$(SIM_TOP).LINES=512 -P$(SIM_TOP).WIN_AW=14 -P$(SIM_TOP).MEM_AW=16 $(SIM_SRCS)
@@ -46,6 +47,40 @@ sim64: $(SIM_SRCS)
 	iverilog -g2005 -o sim/tb64.vvp -s $(SIM_TOP) -P$(SIM_TOP).LINES=2048 -P$(SIM_TOP).WIN_AW=16 -P$(SIM_TOP).MEM_AW=17 $(SIM_SRCS)
 	vvp -n sim/tb64.vvp
 
+# Mixed read/write test (RequestController + two clients + adapter + hostile
+# slave sim/axi4_slave_rand.v): data checked against a command-order reference
+# memory. ADAPTER= / HZ= let you run it on another adapter version, e.g. the
+# old direction-barrier one:  make simthru ADAPTER=/tmp/old.v HZ=
+ADAPTER  ?= rtl/rc_axi_fifo_adapter.v
+HZ       ?= -DHAVE_HZ
+MIX_SRCS := sim/tb_adapter_mixed.v rtl/RequestController.v $(FIFO_MODELS) sim/axi4_slave_rand.v $(ADAPTER)
+MIX_P     = -Ptb_adapter_mixed.MODE=$(1) -Ptb_adapter_mixed.N=$(2) -Ptb_adapter_mixed.SEED=$(3) \
+            -Ptb_adapter_mixed.RLAT_MIN=$(4) -Ptb_adapter_mixed.RLAT_MAX=$(5) \
+            -Ptb_adapter_mixed.BLAT_MIN=$(6) -Ptb_adapter_mixed.BLAT_MAX=$(7)
+# $(call MIX_RUN,mode,n,seed,rmin,rmax,bmin,bmax)
+MIX_RUN   = iverilog -g2012 $(HZ) -o sim/tbmix.vvp -s tb_adapter_mixed $(call MIX_P,$(1),$(2),$(3),$(4),$(5),$(6),$(7)) $(MIX_SRCS) && \
+            vvp -n sim/tbmix.vvp | grep -E "RESULT|TIME|MISMATCH|TIMEOUT|flags|PASSED|FAILED" | tee -a sim/mix.log
+
+simmix: $(MIX_SRCS)
+	@rm -f sim/mix.log
+	@set -e; for seed in 1 2 3 4; do \
+	  for lat in "4 60 2 60" "40 40 30 30" "1 8 40 100" "30 90 1 6" "1 1 1 1"; do \
+	    $(MAKE) --no-print-directory _mixrun SEED=$$seed LAT="$$lat"; \
+	  done; \
+	done
+	@if grep -q FAILED sim/mix.log; then echo "simmix: FAILED"; exit 1; \
+	 else echo "simmix: ALL MIXED RUNS PASSED ($$(grep -c PASSED sim/mix.log) runs)"; fi
+
+_mixrun:
+	@$(call MIX_RUN,0,3000,$(SEED),$(word 1,$(LAT)),$(word 2,$(LAT)),$(word 3,$(LAT)),$(word 4,$(LAT)))
+
+# throughput: sequential data-port writes + pixf streaming reads, slave latency
+# RLAT 40 / BLAT 30 (same as the 06 numbers). mode 1 = disjoint lines, 2 = same lines.
+simthru:
+	@rm -f sim/mix.log
+	@$(call MIX_RUN,1,2048,1,40,40,30,30)
+	@$(call MIX_RUN,2,2048,1,40,40,30,30)
+
 simref:
 	iverilog -g2005 -DREF_ADAPTER -o sim/tbref.vvp -s $(SIM_TOP) -P$(SIM_TOP).LINES=2048 -P$(SIM_TOP).WIN_AW=16 -P$(SIM_TOP).MEM_AW=17 $(REF_SRCS)
 	vvp -n sim/tbref.vvp
@@ -55,4 +90,4 @@ overlay:
 	$(VIVADO_BAT) -log $(REPO)/build/logs/rc_test.log -source build_rc_test.tcl
 
 clean:
-	rm -f sim/*.vvp sim/*.vcd *.jou *.log
+	rm -f sim/*.vvp sim/*.vcd sim/mix.log *.jou *.log
diff --git a/06_request_controller_arb_test/README.md b/06_request_controller_arb_test/README.md
index d421ffa..e6820c0 100644
--- a/06_request_controller_arb_test/README.md
+++ b/06_request_controller_arb_test/README.md
@@ -96,9 +96,13 @@ base + `{addr[WIN_AW-4:2], 5'b0}` inside a 2^`WIN_AW` window):
   to `mig_rdf`. No AR is issued while `mig_rdf.prog_full` (400 of 512) is
   high, so it cannot overflow (an overflow would set `bad_cmd`).
 - **Ordering:** MIG runs commands in order; AXI does not order reads against
-  writes. A command of the other direction therefore waits until all
-  in-flight commands of the current direction have completed (B / RLAST).
-  Same-direction streams overlap fully; read/write mixes do not overlap yet.
+  writes. Reads and writes overlap freely; only the command at the head of
+  `mig_caf` is held, and only while it touches the same 32-byte line as an
+  in-flight command of the opposite direction (read-after-write: AR waits for
+  that write's BRESP; write-after-read: AW waits for that read's RLAST). The
+  adapter keeps the line index of each in-flight AW/AR (up to 8 each, freed
+  by the in-order B / RLAST) and compares it with the head command. Same-
+  direction hazards need no check (one ID, in-order responses).
 - `idle` = every command accepted from the RC has completed. The tester's
   write time, and the `D` reply, wait for it: with the FIFOs the tester
   finishes long before the data is in DDR.
@@ -161,6 +165,19 @@ pop (`rden` high) taken by the waiting client. Tests: `N`/`?` before `A`;
 idle; then `B` streaming reads (compare, corrupt -> `F`, repaired by `G`),
 overlap assertions (more than one AW and AR in flight), `b` and `G` again.
 
+Mixed read/write test (`make simmix`, `make simthru`): `sim/tb_adapter_mixed.v`
+drives the RequestController with a data-port client (random reads and writes)
+and a pixf streaming reader over a hot set of 24 lines, against
+`sim/axi4_slave_rand.v`, an AXI slave that may reorder read and write effects:
+writes commit when B is presented, reads sample memory when their burst starts,
+latencies random per transaction. Every read must return the reference line as
+of its position in the mig_caf command stream. 20 runs (4 seeds x 5 latency
+sets) must pass; removing either half of the check (RAW or WAR) makes them
+fail. `make simthru` measures sequential data-port writes with pixf streaming
+reads (2048 each, RLAT 40 / BLAT 30, 25% ready stalls): disjoint lines
+4.91 cyc/line moved (652 MB/s combined) against 10.37 (308 MB/s) with the old
+direction barrier; the worst case, both walking the same lines, 7.54 cyc/line.
+
 Simulated results, 2048 lines (64 KiB), same slave and 100 MHz:
 
 | | 05 adapter (`simref`) | 06 FIFO adapter |
@@ -239,7 +256,10 @@ touch /home/xilinx/rc_arb_test/stop
 
 - Arbitration between clients is untested: only `data_*` (and `pixf_*` for
   streaming reads) are live. That comes next, with several fake clients.
-- Read/write direction barrier, 8 outstanding, and the async FIFOs (both
+- 8 outstanding (head-of-line: commands leave `mig_caf` in order, so a full read
+  window holds up writes behind it and vice versa; raising `MAX_WR_OUT` /
+  `MAX_RD_OUT` to 12 took the mixed `simthru` case from 20108 to 16802 cycles)
+  and the async FIFOs (both
   clocks on FCLK0) are left as they are; Erik wants those optimizations
   later. A faster AXI clock on FCLK1 can use the same dual-clock FIFOs
   once the controller side keeps the bus fed.
diff --git a/06_request_controller_arb_test/rtl/rc_axi_fifo_adapter.v b/06_request_controller_arb_test/rtl/rc_axi_fifo_adapter.v
index 3284628..91257b0 100644
--- a/06_request_controller_arb_test/rtl/rc_axi_fifo_adapter.v
+++ b/06_request_controller_arb_test/rtl/rc_axi_fifo_adapter.v
@@ -35,11 +35,20 @@
 //  * up to MAX_WR_OUT writes and MAX_RD_OUT reads in flight (counted from
 //    issue to BRESP / RLAST). They overlap because AW, W and B, and AR and
 //    R, are independent channels fed by the FIFOs.
-//  * ORDERING: MIG executes commands in order, AXI does not order reads
-//    against writes. So a command of the other direction is held until the
-//    in-flight ones of the current direction have all completed (BRESP /
-//    RLAST). Same-direction streams overlap; mixed read/write traffic
-//    does not (yet).
+//  * ORDERING: MIG executes commands in order, AXI (HP0) does not order reads
+//    against writes. Reads and writes overlap freely, except that the command
+//    at the head of mig_caf is held while it touches the same 32-byte line as
+//    an in-flight transaction of the OPPOSITE direction:
+//      read-after-write: the AR waits until that write's BRESP has arrived
+//      write-after-read: the AW waits until that read's RLAST has arrived
+//    (same-direction hazards need no check: one ID, in-order responses).
+//    The check compares the line index addr[WIN_AW-4:2] against a tag per
+//    in-flight command (tags are kept in issue order and freed in response
+//    order, since all responses are in order). Because every command is a
+//    whole aligned 32-byte block, equal tags means overlap and different tags
+//    means no overlap, so the check is exact (window wrapping is part of the
+//    tag). Commands still leave mig_caf in order, so a held command also
+//    holds the ones behind it.
 //  * W: a write burst takes two mig_wdf entries (first entry = bytes 0..15,
 //    each entry = two 64-bit beats, lower first; WSTRB = ~mask). W beats are
 //    sent only for AWs that have already handshaked (credit counter).
@@ -183,10 +192,29 @@ module rc_axi_fifo_adapter #(
     wire        is_rd = caf_v && (cmd == 3'b001);
     wire        is_bad = caf_v && !is_wr && !is_rd;
 
+    // ---- address-conflict check against in-flight opposite-direction tags
+    localparam TAGW = WIN_AW - 4 - 2 + 1;           // addr[WIN_AW-4:2]
+    wire [TAGW-1:0] hd_tag = caf_d[WIN_AW-4:2];
+    reg  [TAGW-1:0] wtag [0:MAX_WR_OUT-1];          // writes: AW issued, B not yet seen
+    reg  [TAGW-1:0] rtag [0:MAX_RD_OUT-1];          // reads: AR issued, RLAST not yet seen
+    reg  [MAX_WR_OUT-1:0] wtv;
+    reg  [MAX_RD_OUT-1:0] rtv;
+    reg  [3:0] wt_head, wt_tail, rt_head, rt_tail;  // slots used in issue order
+    reg        raw_hz, war_hz;
+    integer    ci;
+    always @(*) begin
+        raw_hz = 1'b0;                              // head read vs in-flight writes
+        for (ci = 0; ci < MAX_WR_OUT; ci = ci + 1)
+            if (wtv[ci] && (wtag[ci] == hd_tag)) raw_hz = 1'b1;
+        war_hz = 1'b0;                              // head write vs in-flight reads
+        for (ci = 0; ci < MAX_RD_OUT; ci = ci + 1)
+            if (rtv[ci] && (rtag[ci] == hd_tag)) war_hz = 1'b1;
+    end
+
     wire aw_free = !m_axi_awvalid || m_axi_awready;
     wire ar_free = !m_axi_arvalid || m_axi_arready;
-    wire wr_ok = is_wr && (rd_out == 4'd0) && (wr_out < MAX_WR_OUT) && aw_free;
-    wire rd_ok = is_rd && (wr_out == 4'd0) && (rd_out < MAX_RD_OUT) && ar_free
+    wire wr_ok = is_wr && !war_hz && (wr_out < MAX_WR_OUT) && aw_free;
+    wire rd_ok = is_rd && !raw_hz && (rd_out < MAX_RD_OUT) && ar_free
                  && !rdf_pf;
     assign caf_rd = wr_ok || rd_ok || is_bad;
 
@@ -226,8 +254,17 @@ module rc_axi_fifo_adapter #(
     reg          rbeat;
     reg  [63:0]  r_lo;
 
+    reg [MAX_WR_OUT-1:0] wtv_n;
+    reg [MAX_RD_OUT-1:0] rtv_n;
+
     always @(posedge clk) begin
         if (rst) begin
+            wtv           <= {MAX_WR_OUT{1'b0}};
+            rtv           <= {MAX_RD_OUT{1'b0}};
+            wt_head       <= 4'd0;
+            wt_tail       <= 4'd0;
+            rt_head       <= 4'd0;
+            rt_tail       <= 4'd0;
             wr_out        <= 4'd0;
             rd_out        <= 4'd0;
             m_axi_awvalid <= 1'b0;
@@ -268,6 +305,30 @@ module rc_axi_fifo_adapter #(
             end
             if (is_bad) bad_cmd <= 1'b1;
 
+            // ---- in-flight tags: allocated at issue, freed by the (in-order) response
+            wtv_n = wtv;
+            rtv_n = rtv;
+            if (wr_done) begin
+                wtv_n[wt_head] = 1'b0;
+                wt_head <= (wt_head == MAX_WR_OUT - 1) ? 4'd0 : wt_head + 4'd1;
+            end
+            if (rd_done) begin
+                rtv_n[rt_head] = 1'b0;
+                rt_head <= (rt_head == MAX_RD_OUT - 1) ? 4'd0 : rt_head + 4'd1;
+            end
+            if (issue_wr) begin
+                wtag[wt_tail]   <= hd_tag;
+                wtv_n[wt_tail]   = 1'b1;
+                wt_tail <= (wt_tail == MAX_WR_OUT - 1) ? 4'd0 : wt_tail + 4'd1;
+            end
+            if (issue_rd) begin
+                rtag[rt_tail]   <= hd_tag;
+                rtv_n[rt_tail]   = 1'b1;
+                rt_tail <= (rt_tail == MAX_RD_OUT - 1) ? 4'd0 : rt_tail + 4'd1;
+            end
+            wtv <= wtv_n;
+            rtv <= rtv_n;
+
             // ---- in-flight counters (+ peak tracking)
             wr_out <= wr_out + {3'b0, issue_wr} - {3'b0, wr_done};
             rd_out <= rd_out + {3'b0, issue_rd} - {3'b0, rd_done};
diff --git a/06_request_controller_arb_test/sim/axi4_slave_rand.v b/06_request_controller_arb_test/sim/axi4_slave_rand.v
new file mode 100644
index 0000000..5bcc2d8
--- /dev/null
+++ b/06_request_controller_arb_test/sim/axi4_slave_rand.v
@@ -0,0 +1,185 @@
+// AXI4 slave memory for the mixed read/write hazard test (tb_adapter_mixed).
+// Like axi4_slave_pipe (single ID, in-order B and R, INCR, WSTRB, queued AW/AR)
+// but made hostile on purpose, the way HP0 may legally behave:
+//   * read and write paths are completely independent: nothing orders a read
+//     against a write (or the reverse) except the master waiting for B / RLAST
+//   * a write is COMMITTED to memory only when its B is presented
+//     (BLAT_MIN..BLAT_MAX cycles after the last W beat)
+//   * a read SAMPLES memory (all 4 beats at once) when its burst starts, which
+//     is RLAT_MIN..RLAT_MAX cycles after the AR was accepted (or later, if the
+//     previous burst is still being delivered)
+// So an AR issued before an earlier same-line write's B can see old data, and an
+// AW issued before an earlier same-line read's RLAST can overwrite the data that
+// read is about to sample. A master that waits for B (RAW) / RLAST (WAR) always
+// sees the right data; one that does not will read stale or too-new data.
+// Latencies are drawn per transaction from an xorshift generator (SEED).
+`timescale 1ns / 1ps
+module axi4_slave_rand #(
+    parameter MEM_AW   = 16,
+    parameter QD       = 16,
+    parameter RLAT_MIN = 4,
+    parameter RLAT_MAX = 60,
+    parameter BLAT_MIN = 2,
+    parameter BLAT_MAX = 60,
+    parameter STALL    = 1,                   // 1: random ready de-assertion (~25 %)
+    parameter SEED     = 32'h1234_5678
+) (
+    input  wire        clk,
+    input  wire        rst,
+    input  wire [31:0] s_axi_awaddr,
+    input  wire [7:0]  s_axi_awlen,
+    input  wire        s_axi_awvalid,
+    output reg         s_axi_awready,
+    input  wire [63:0] s_axi_wdata,
+    input  wire [7:0]  s_axi_wstrb,
+    input  wire        s_axi_wlast,
+    input  wire        s_axi_wvalid,
+    output reg         s_axi_wready,
+    output wire [1:0]  s_axi_bresp,
+    output reg         s_axi_bvalid,
+    input  wire        s_axi_bready,
+    input  wire [31:0] s_axi_araddr,
+    input  wire [7:0]  s_axi_arlen,
+    input  wire        s_axi_arvalid,
+    output reg         s_axi_arready,
+    output wire [63:0] s_axi_rdata,
+    output wire [1:0]  s_axi_rresp,
+    output wire        s_axi_rlast,
+    output wire        s_axi_rvalid,
+    input  wire        s_axi_rready
+);
+    localparam DEPTH = (1 << MEM_AW);
+    reg [7:0] mem [0:DEPTH-1];
+    integer k;
+    initial for (k = 0; k < DEPTH; k = k + 1) mem[k] = 8'hCC;
+
+    reg [31:0] rng;
+    function [31:0] nxt(input [31:0] x);
+        reg [31:0] y;
+        begin y = x ^ (x << 13); y = y ^ (y >> 17); nxt = y ^ (y << 5); end
+    endfunction
+    function integer rrange(input integer lo, input integer hi, input [31:0] x);
+        begin rrange = lo + ((hi > lo) ? (x[30:0] % (hi - lo + 1)) : 0); end
+    endfunction
+
+    assign s_axi_bresp = 2'b00;
+    assign s_axi_rresp = 2'b00;
+
+    // ---- AW queue / W burst assembly ----
+    reg [31:0] awq_a [0:QD-1];
+    reg [7:0]  awq_l [0:QD-1];
+    integer awq_wp, awq_rp, awq_n;
+    reg [31:0] wa;  reg [7:0] wl, wc;  reg wact;
+    reg [63:0] wbd [0:255];  reg [7:0] wbs [0:255];        // current burst buffer
+    // ---- B queue: completed bursts waiting for their commit/B time ----
+    reg [31:0] bq_a [0:QD*2-1];
+    reg [7:0]  bq_l [0:QD*2-1];
+    reg [63:0] bq_d [0:QD*2-1][0:3];
+    reg [7:0]  bq_s [0:QD*2-1][0:3];
+    integer    bq_t [0:QD*2-1];
+    integer bq_wp, bq_rp, bq_n;
+    integer now;
+    // ---- AR queue ----
+    reg [31:0] arq_a [0:QD-1];
+    reg [7:0]  arq_l [0:QD-1];
+    integer    arq_t [0:QD-1];
+    integer arq_wp, arq_rp, arq_n;
+    // ---- R burst ----
+    reg [63:0] rbuf [0:255];
+    reg [7:0]  rl, rc;  reg ract;
+    reg [63:0] rd_q;  reg rv_q, rlast_q;
+    assign s_axi_rdata = rd_q;  assign s_axi_rvalid = rv_q;  assign s_axi_rlast = rlast_q;
+
+    integer i, j;
+    reg [31:0] a_t;
+    reg [31:0] ra;
+    reg        stall, bv_next, bhead_done;
+
+    always @(posedge clk) begin
+        if (rst) begin
+            rng = SEED;
+            awq_wp = 0; awq_rp = 0; awq_n = 0; wact = 0; wa = 0; wl = 0; wc = 0;
+            bq_wp = 0; bq_rp = 0; bq_n = 0; now = 0; bhead_done = 0;
+            arq_wp = 0; arq_rp = 0; arq_n = 0; ract = 0; rl = 0; rc = 0;
+            rv_q <= 1'b0; rlast_q <= 1'b0; rd_q <= 64'd0;
+            s_axi_awready <= 1'b0; s_axi_wready <= 1'b0; s_axi_bvalid <= 1'b0; s_axi_arready <= 1'b0;
+        end else begin
+            now = now + 1;
+            rng = nxt(rng);
+            stall = (STALL != 0) && (rng[9:8] == 2'b00);
+            // B handshake
+            if (s_axi_bvalid && s_axi_bready) begin
+                bq_rp = bq_rp + 1; bq_n = bq_n - 1; bhead_done = 0;
+            end
+            // AW accept
+            if (s_axi_awvalid && s_axi_awready) begin
+                awq_a[awq_wp % QD] = s_axi_awaddr;
+                awq_l[awq_wp % QD] = s_axi_awlen;
+                awq_wp = awq_wp + 1; awq_n = awq_n + 1;
+            end
+            // W accept: buffer the burst, memory is NOT updated yet
+            if (s_axi_wvalid && s_axi_wready) begin
+                if (!wact) begin
+                    wa = awq_a[awq_rp % QD]; wl = awq_l[awq_rp % QD]; wc = 0;
+                    awq_rp = awq_rp + 1; awq_n = awq_n - 1;
+                    wact = 1;
+                end
+                wbd[wc] = s_axi_wdata; wbs[wc] = s_axi_wstrb;
+                if (s_axi_wlast || wc == wl) begin
+                    wact = 0;
+                    bq_a[bq_wp % (QD*2)] = wa;
+                    bq_l[bq_wp % (QD*2)] = wl;
+                    for (j = 0; j <= 3; j = j + 1) begin
+                        bq_d[bq_wp % (QD*2)][j] = wbd[j];
+                        bq_s[bq_wp % (QD*2)][j] = wbs[j];
+                    end
+                    bq_t[bq_wp % (QD*2)] = now + rrange(BLAT_MIN, BLAT_MAX, rng);
+                    bq_wp = bq_wp + 1; bq_n = bq_n + 1;
+                end else
+                    wc = wc + 1;
+            end
+            // AR accept
+            if (s_axi_arvalid && s_axi_arready) begin
+                arq_a[arq_wp % QD] = s_axi_araddr;
+                arq_l[arq_wp % QD] = s_axi_arlen;
+                arq_t[arq_wp % QD] = now + rrange(RLAT_MIN, RLAT_MAX, nxt(rng));
+                arq_wp = arq_wp + 1; arq_n = arq_n + 1;
+            end
+            // R channel
+            if (rv_q && s_axi_rready) begin
+                rv_q <= 1'b0; rlast_q <= 1'b0;
+            end
+            if (!rv_q || s_axi_rready) begin
+                if (!ract && arq_n > 0 && now >= arq_t[arq_rp % QD]) begin
+                    ra = arq_a[arq_rp % QD]; rl = arq_l[arq_rp % QD]; rc = 0;
+                    arq_rp = arq_rp + 1; arq_n = arq_n - 1;
+                    ract = 1;
+                    for (j = 0; j <= rl; j = j + 1)       // sample the whole burst now
+                        for (i = 0; i < 8; i = i + 1)
+                            rbuf[j][i*8 +: 8] = mem[(ra + j*8 + i) & (DEPTH - 1)];
+                end
+                if (ract) begin
+                    rd_q    <= rbuf[rc];
+                    rv_q    <= 1'b1;
+                    rlast_q <= (rc == rl);
+                    if (rc == rl) ract = 0; else rc = rc + 1;
+                end
+            end
+            s_axi_awready <= (awq_n < QD) && !stall;
+            s_axi_wready  <= (wact || awq_n > 0) && !stall;
+            s_axi_arready <= (arq_n < QD) && !stall;
+            // B: the head write is committed to memory in the cycle before its B
+            // is first presented (bready is assumed 1, as in the adapter)
+            bv_next = (bq_n > 0) && ((now + 1) >= bq_t[bq_rp % (QD*2)]);
+            if (bv_next && !bhead_done) begin
+                bhead_done = 1;
+                for (j = 0; j <= 3; j = j + 1)
+                    for (i = 0; i < 8; i = i + 1)
+                        if (bq_s[bq_rp % (QD*2)][j][i])
+                            mem[(bq_a[bq_rp % (QD*2)] + j*8 + i) & (DEPTH - 1)] =
+                                bq_d[bq_rp % (QD*2)][j][i*8 +: 8];
+            end
+            s_axi_bvalid  <= bv_next;
+        end
+    end
+endmodule
diff --git a/06_request_controller_arb_test/sim/tb_adapter_mixed.v b/06_request_controller_arb_test/sim/tb_adapter_mixed.v
new file mode 100644
index 0000000..4e4b510
--- /dev/null
+++ b/06_request_controller_arb_test/sim/tb_adapter_mixed.v
@@ -0,0 +1,377 @@
+// Mixed read/write test for rc_axi_fifo_adapter: the cs150 RequestController
+// (verbatim) with two behavioural clients, rc_axi_fifo_adapter (with the mig_*
+// FIFO models) and the hostile slave sim/axi4_slave_rand.v.
+//   data port : Cache.v-style WRITE1/WRITE2 and FETCH/READ1/READ2 (reads AND writes)
+//   pixf port : read-only streaming reads, up to the FIFO credit in flight
+// A reference memory is updated in command order, at the cycle each command is
+// accepted into mig_caf (that IS the order MIG would execute them in). Each read
+// result must equal the reference line as of its position in that order, so any
+// RAW / WAR reordering by the AXI side shows up as a data mismatch.
+//
+// MODE 0  random mix over a small hot set of lines (many same-line hazards)
+// MODE 1  throughput: sequential writes to lines [WBASE..] while pixf streams
+//         lines [RBASE..] (disjoint regions) - no hazards, overlap is free
+// MODE 2  throughput, worst case: writes and streaming reads walk the SAME lines
+// Parameters (iverilog -P): MODE N SEED RLAT_MIN RLAT_MAX BLAT_MIN BLAT_MAX HOT GAP
+// Needs iverilog -g2012. -DHAVE_HZ adds the hazard-hold statistics (patched adapter only).
+`timescale 1ns / 1ps
+module tb_adapter_mixed;
+    parameter MODE     = 0;
+    parameter N        = 4000;               // data-port ops / pixf reads
+    parameter SEED     = 1;
+    parameter WIN_AW   = 14;
+    parameter MEM_AW   = 16;
+    parameter RLAT_MIN = 4;
+    parameter RLAT_MAX = 60;
+    parameter BLAT_MIN = 2;
+    parameter BLAT_MAX = 60;
+    parameter STALL    = 1;
+    parameter HOT      = 24;                 // MODE 0: hot-set size in lines
+    parameter GAP      = 2;                  // MODE 0: max idle cycles between ops
+    parameter [31:0] BASE = 32'h1684_9F20;
+    localparam NLINES = 1 << (WIN_AW - 5);
+
+    reg clk, rst;
+    initial clk = 1'b0;
+    always #5 clk = ~clk;
+
+    // ---------------- DUT chain ----------------
+    wire         rcon_caf_full, rcon_caf_wren, rcon_wdf_full, rcon_wdf_wren;
+    wire [33:0]  rcon_caf_cadr;
+    wire [143:0] rcon_wdf_mdat;
+    wire         rcon_rdf_rden, rcon_rdf_wren;
+    wire [127:0] rdf_data;
+    wire         data_caf_full, data_wdf_full, data_rdf_wren, pixf_raf_full, pixf_rdf_wren;
+    reg          data_caf_wren, data_wdf_wren, data_rdf_rden;
+    reg  [33:0]  data_caf_cadr;
+    reg  [143:0] data_wdf_mdat;
+    reg          pixf_raf_wren, pixf_rdf_rden;
+    reg  [30:0]  pixf_raf_addr;
+
+    RequestController rc (
+        .clk(clk), .rst(rst),
+        .caf_full(rcon_caf_full), .wdf_full(rcon_wdf_full), .rdf_wren(rcon_rdf_wren),
+        .inst_caf_wren(1'b0), .inst_caf_cadr(34'd0), .inst_wdf_wren(1'b0),
+        .inst_wdf_mdat(144'd0), .inst_rdf_rden(1'b0), .inst_stall(1'b0),
+        .data_caf_wren(data_caf_wren), .data_caf_cadr(data_caf_cadr),
+        .data_wdf_wren(data_wdf_wren), .data_wdf_mdat(data_wdf_mdat),
+        .data_rdf_rden(data_rdf_rden), .data_stall(1'b0),
+        .gcmd_raf_wren(1'b0), .gcmd_raf_addr(31'd0), .gcmd_rdf_rden(1'b0),
+        .pixf_raf_wren(pixf_raf_wren), .pixf_raf_addr(pixf_raf_addr), .pixf_rdf_rden(pixf_rdf_rden),
+        .fill_waf_wren(1'b0), .fill_waf_addr(31'd0), .fill_wdf_wren(1'b0), .fill_wdf_mdat(144'd0),
+        .line_waf_wren(1'b0), .line_waf_addr(31'd0), .line_wdf_wren(1'b0), .line_wdf_mdat(144'd0),
+        .bpas_waf_wren(1'b0), .bpas_waf_addr(31'd0), .bpas_wdf_wren(1'b0), .bpas_wdf_mdat(144'd0),
+        .caf_wren(rcon_caf_wren), .caf_cadr(rcon_caf_cadr),
+        .wdf_wren(rcon_wdf_wren), .wdf_mdat(rcon_wdf_mdat), .rdf_rden(rcon_rdf_rden),
+        .inst_caf_full(), .inst_wdf_full(), .inst_rdf_wren(),
+        .data_caf_full(data_caf_full), .data_wdf_full(data_wdf_full),
+        .data_rdf_wren(data_rdf_wren),
+        .gcmd_raf_full(), .gcmd_rdf_wren(), .pixf_raf_full(pixf_raf_full), .pixf_rdf_wren(pixf_rdf_wren),
+        .fill_waf_full(), .fill_wdf_full(), .line_waf_full(), .line_wdf_full(),
+        .bpas_waf_full(), .bpas_wdf_full());
+
+    wire [0:0] awid, bid, arid, rid;
+    wire [31:0] awaddr, araddr;
+    wire [7:0] awlen, arlen;
+    wire [2:0] awsize, arsize;
+    wire [1:0] awburst, arburst, bresp, rresp;
+    wire awvalid, awready, wvalid, wready, wlast, bvalid, bready;
+    wire arvalid, arready, rvalid, rready, rlast;
+    wire [63:0] wdata, rdata;
+    wire [7:0] wstrb;
+    wire axi_err, bad_cmd, a_idle;
+    wire [3:0] peak_wr, peak_rd;
+    reg  clr_err;
+
+    rc_axi_fifo_adapter #(.WIN_AW(WIN_AW)) u_adapter (
+        .clk(clk), .rst(rst), .base_addr(BASE), .clr_err(clr_err),
+        .axi_err(axi_err), .bad_cmd(bad_cmd), .peak_wr(peak_wr), .peak_rd(peak_rd), .idle(a_idle),
+        .caf_wren(rcon_caf_wren), .caf_cadr(rcon_caf_cadr), .caf_full(rcon_caf_full),
+        .wdf_wren(rcon_wdf_wren), .wdf_mdat(rcon_wdf_mdat), .wdf_full(rcon_wdf_full),
+        .rdf_wren(rcon_rdf_wren), .rdf_data(rdf_data), .rdf_rden(rcon_rdf_rden),
+        .m_axi_awid(awid), .m_axi_awaddr(awaddr), .m_axi_awlen(awlen),
+        .m_axi_awsize(awsize), .m_axi_awburst(awburst), .m_axi_awlock(),
+        .m_axi_awcache(), .m_axi_awprot(), .m_axi_awqos(), .m_axi_awregion(),
+        .m_axi_awvalid(awvalid), .m_axi_awready(awready),
+        .m_axi_wdata(wdata), .m_axi_wstrb(wstrb), .m_axi_wlast(wlast),
+        .m_axi_wvalid(wvalid), .m_axi_wready(wready),
+        .m_axi_bid(bid), .m_axi_bresp(bresp), .m_axi_bvalid(bvalid), .m_axi_bready(bready),
+        .m_axi_arid(arid), .m_axi_araddr(araddr), .m_axi_arlen(arlen),
+        .m_axi_arsize(arsize), .m_axi_arburst(arburst), .m_axi_arlock(),
+        .m_axi_arcache(), .m_axi_arprot(), .m_axi_arqos(), .m_axi_arregion(),
+        .m_axi_arvalid(arvalid), .m_axi_arready(arready),
+        .m_axi_rid(rid), .m_axi_rdata(rdata), .m_axi_rresp(rresp),
+        .m_axi_rlast(rlast), .m_axi_rvalid(rvalid), .m_axi_rready(rready));
+    assign bid = 1'b0;
+    assign rid = 1'b0;
+
+    axi4_slave_rand #(.MEM_AW(MEM_AW), .STALL(STALL), .SEED(32'h9E37_79B9 * (SEED + 1)),
+                      .RLAT_MIN(RLAT_MIN), .RLAT_MAX(RLAT_MAX),
+                      .BLAT_MIN(BLAT_MIN), .BLAT_MAX(BLAT_MAX)) u_mem (
+        .clk(clk), .rst(rst),
+        .s_axi_awaddr(awaddr), .s_axi_awlen(awlen), .s_axi_awvalid(awvalid), .s_axi_awready(awready),
+        .s_axi_wdata(wdata), .s_axi_wstrb(wstrb), .s_axi_wlast(wlast),
+        .s_axi_wvalid(wvalid), .s_axi_wready(wready),
+        .s_axi_bresp(bresp), .s_axi_bvalid(bvalid), .s_axi_bready(bready),
+        .s_axi_araddr(araddr), .s_axi_arlen(arlen), .s_axi_arvalid(arvalid), .s_axi_arready(arready),
+        .s_axi_rdata(rdata), .s_axi_rresp(rresp), .s_axi_rlast(rlast),
+        .s_axi_rvalid(rvalid), .s_axi_rready(rready));
+
+    // ---------------- reference model ----------------
+    reg [255:0] refm [0:NLINES-1];
+    function [255:0] genline(input integer line, input integer ver);
+        integer w;
+        reg [255:0] t;
+        begin
+            for (w = 0; w < 8; w = w + 1)
+                t[w*32 +: 32] = (ver * 32'h9E37_79B1) ^ {line[15:0], 8'h5A, w[7:0]} ^ (ver << 20);
+            genline = t;
+        end
+    endfunction
+    // line image as the slave memory sees it: bytes 0..15 = first 128-bit half
+    task poke_line(input integer line, input [255:0] l);
+        integer b;
+        reg [31:0] a;
+        begin
+            for (b = 0; b < 32; b = b + 1) begin
+                a = (BASE + line * 32 + b) & ((1 << MEM_AW) - 1);
+                u_mem.mem[a] = (b < 16) ? l[128 + b*8 +: 8] : l[(b-16)*8 +: 8];
+            end
+        end
+    endtask
+    function [255:0] peek_line(input integer line);
+        integer b;
+        reg [31:0] a;
+        reg [255:0] t;
+        begin
+            for (b = 0; b < 32; b = b + 1) begin
+                a = (BASE + line * 32 + b) & ((1 << MEM_AW) - 1);
+                if (b < 16) t[128 + b*8 +: 8] = u_mem.mem[a];
+                else        t[(b-16)*8 +: 8]  = u_mem.mem[a];
+            end
+            peek_line = t;
+        end
+    endfunction
+
+    // ---------------- random numbers (tb side) ----------------
+    reg [31:0] trng;
+    function [31:0] nxt(input [31:0] x);
+        reg [31:0] y;
+        begin y = x ^ (x << 13); y = y ^ (y >> 17); nxt = y ^ (y << 5); end
+    endfunction
+    always @(posedge clk) trng <= nxt(trng);
+
+    // ---------------- data-port client (Cache.v handshake) ----------------
+    localparam D_IDLE = 0, D_W1 = 1, D_W2 = 2, D_F = 3, D_R1 = 4, D_R2 = 5, D_GAP = 6;
+    integer dcs, d_ops, d_gap, d_line, d_seq, wver;
+    reg [255:0] d_L, d_exp, d_half;
+    reg         d_done;
+    integer     errors, wr_cmds, rd_cmds_d, rd_cmds_p, hz_raw, hz_war;
+    reg [255:0] d_got;
+
+    // pixf client
+    integer p_issued, p_got, p_gap, p_line;
+    reg     p_half;
+    reg [127:0] p_e0;
+    reg     p_busy;
+    reg [255:0] expq [0:262143];
+    integer qh, qt;
+    integer p_total;
+    reg started;
+    integer t0, t1, cyc;
+
+    function integer wr_line(input integer k);
+        begin
+            if (MODE == 0)      wr_line = (trng[23:8] % HOT);
+            else if (MODE == 1) wr_line = (NLINES/2) + (k % (NLINES/2));
+            else                wr_line = (k % (NLINES/2));
+        end
+    endfunction
+    function integer rd_line(input integer k);
+        begin
+            if (MODE == 0)      rd_line = (trng[27:12] % HOT);
+            else                rd_line = (k % (NLINES/2));
+        end
+    endfunction
+
+    // reference-model update / expectation capture: at the accept cycle
+    always @(posedge clk) if (!rst && rcon_caf_wren) begin : acc
+        integer ln;
+        ln = (rcon_caf_cadr[30:0] >> 2) & (NLINES - 1);
+        if (rcon_caf_cadr[33:31] == 3'b000) begin
+            refm[ln] = d_L;                       // only the data port writes
+            wr_cmds = wr_cmds + 1;
+        end else if (rc.fifo_access == 3'b001) begin
+            d_exp = refm[ln];                     // data-port read
+            rd_cmds_d = rd_cmds_d + 1;
+        end else begin
+            expq[qt % 262144] = refm[ln];         // pixf read
+            qt = qt + 1;
+            rd_cmds_p = rd_cmds_p + 1;
+        end
+    end
+
+    always @(posedge clk) begin
+        if (rst) begin
+            dcs <= D_IDLE; d_ops <= 0; d_done <= 1'b0; d_seq = 0; wver = 0;
+            data_caf_wren <= 1'b0; data_wdf_wren <= 1'b0; data_rdf_rden <= 1'b0;
+            data_caf_cadr <= 34'd0; data_wdf_mdat <= 144'd0; d_gap = 0;
+        end else begin
+            case (dcs)
+            D_IDLE: if (started && !d_done) begin
+                if (d_ops >= N) d_done <= 1'b1;
+                else begin
+                    d_line = wr_line(d_ops);
+                    if (MODE == 0 && trng[3]) begin     // read
+                        data_caf_cadr <= {3'b001, d_line[22:0] << 2 | 31'd0};
+                        data_caf_wren <= 1'b1;
+                        dcs <= D_F;
+                    end else begin                      // write
+                        wver = wver + 1;
+                        d_L = genline(d_line, wver);
+                        data_caf_cadr <= {3'b000, 31'(d_line << 2)};
+                        data_caf_wren <= 1'b1;
+                        data_wdf_wren <= 1'b1;
+                        data_wdf_mdat <= {16'h0000, genline(d_line, wver) >> 128};
+                        dcs <= D_W1;
+                    end
+                end
+            end
+            D_W1: if (!data_caf_full && !data_wdf_full) begin
+                data_caf_wren <= 1'b0;
+                data_wdf_mdat <= {16'h0000, d_L[127:0]};
+                dcs <= D_W2;
+            end
+            D_W2: if (!data_wdf_full) begin
+                data_wdf_wren <= 1'b0;
+                d_ops <= d_ops + 1;
+                d_gap = (MODE == 0) ? (trng[31:29] % (GAP + 1)) : 0;
+                dcs <= (d_gap > 0) ? D_GAP : D_IDLE;
+            end
+            D_F: if (!data_caf_full) begin
+                data_caf_wren <= 1'b0;
+                data_rdf_rden <= 1'b1;
+                dcs <= D_R1;
+            end
+            D_R1: if (data_rdf_wren) begin
+                d_half <= {rdf_data, 128'd0};
+                dcs <= D_R2;
+            end
+            D_R2: if (data_rdf_wren) begin
+                data_rdf_rden <= 1'b0;
+                d_got = d_half | rdf_data;
+                if (d_got !== d_exp) begin
+                    errors = errors + 1;
+                    if (errors < 10)
+                        $display("MISMATCH data-port read line %0d t=%0d\n   got %h\n   exp %h", d_line, cyc, d_got, d_exp);
+                end
+                d_ops <= d_ops + 1;
+                d_gap = (MODE == 0) ? (trng[31:29] % (GAP + 1)) : 0;
+                dcs <= (d_gap > 0) ? D_GAP : D_IDLE;
+            end
+            D_GAP: begin
+                d_gap = d_gap - 1;
+                if (d_gap <= 0) dcs <= D_IDLE;
+            end
+            endcase
+        end
+    end
+
+    // pixf client: issues reads back to back (random pauses in MODE 0), keeps
+    // pixf_rdf_rden high, and checks each returned line against the queue.
+    always @(posedge clk) begin
+        if (rst) begin
+            p_issued = 0; p_got = 0; p_gap = 0; p_busy = 0; p_half = 0;
+            pixf_raf_wren <= 1'b0; pixf_rdf_rden <= 1'b0; pixf_raf_addr <= 31'd0;
+            qh = 0;
+        end else begin
+            pixf_rdf_rden <= started;
+            if (pixf_raf_wren && !pixf_raf_full) begin   // accepted this cycle
+                pixf_raf_wren <= 1'b0;
+                p_issued = p_issued + 1;
+                p_gap = (MODE == 0) ? (trng[30:28] % (GAP + 1)) : 0;
+            end else if (!pixf_raf_wren && started && p_issued < N) begin
+                if (p_gap > 0) p_gap = p_gap - 1;
+                else begin
+                    p_line = rd_line(p_issued);
+                    pixf_raf_addr <= 31'(p_line << 2);
+                    pixf_raf_wren <= 1'b1;
+                end
+            end
+            if (pixf_rdf_wren) begin
+                if (!p_half) begin p_e0 = rdf_data; p_half = 1; end
+                else begin
+                    p_half = 0;
+                    if ({p_e0, rdf_data} !== expq[qh % 262144]) begin
+                        errors = errors + 1;
+                        if (errors < 10)
+                            $display("MISMATCH pixf read #%0d t=%0d\n   got %h\n   exp %h", p_got, cyc,
+                                     {p_e0, rdf_data}, expq[qh % 262144]);
+                    end
+                    qh = qh + 1; p_got = p_got + 1;
+                end
+            end
+        end
+    end
+
+    always @(posedge clk) cyc <= rst ? 0 : cyc + 1;
+    // hazard statistics (cycles the head command is held by the conflict check);
+    // only with the address-conflict adapter (-DHAVE_HZ)
+    integer held_raw, held_war;
+    always @(posedge clk) if (!rst) begin
+`ifdef HAVE_HZ
+        if (u_adapter.raw_hz && u_adapter.is_rd && u_adapter.caf_v) held_raw = held_raw + 1;
+        if (u_adapter.war_hz && u_adapter.is_wr && u_adapter.caf_v) held_war = held_war + 1;
+`endif
+    end
+
+    // ---------------- sequencing ----------------
+    integer i, f;
+    reg [255:0] pk;
+    initial begin
+        trng = 32'hC001_D00D ^ (SEED * 32'h1357_9BDF);
+        errors = 0; wr_cmds = 0; rd_cmds_d = 0; rd_cmds_p = 0; qt = 0;
+        held_raw = 0; held_war = 0;
+        started = 0; clr_err = 0; rst = 1;
+        for (i = 0; i < NLINES; i = i + 1) begin
+            refm[i] = genline(i, 0);
+            poke_line(i, refm[i]);
+        end
+        repeat (10) @(posedge clk);
+        rst <= 0;
+        repeat (10) @(posedge clk);
+        started <= 1;
+        t0 = cyc;
+        // wait for both clients and all read data
+        f = 0;
+        while (!(d_done && p_got >= N) && f < 400000) begin
+            @(posedge clk); f = f + 1;
+        end
+        t1 = cyc;
+        if (f >= 400000) begin
+            errors = errors + 1;
+            $display("TIMEOUT: d_ops=%0d p_issued=%0d p_got=%0d", d_ops, p_issued, p_got);
+        end
+        // let writes complete
+        f = 0;
+        while (!a_idle && f < 2000) begin @(posedge clk); f = f + 1; end
+        repeat (50) @(posedge clk);
+        for (i = 0; i < NLINES; i = i + 1) begin
+            pk = peek_line(i);
+            if (pk !== refm[i]) begin
+                errors = errors + 1;
+                if (errors < 10) $display("MISMATCH final memory line %0d got %h exp %h", i, pk, refm[i]);
+            end
+        end
+        if (axi_err || bad_cmd) begin errors = errors + 1; $display("adapter flags: axi_err=%b bad_cmd=%b", axi_err, bad_cmd); end
+        $display("RESULT mode=%0d seed=%0d lat R%0d-%0d B%0d-%0d: writes=%0d dport_reads=%0d pixf_reads=%0d peak W=%0d R=%0d held raw=%0d war=%0d",
+                 MODE, SEED, RLAT_MIN, RLAT_MAX, BLAT_MIN, BLAT_MAX, wr_cmds, rd_cmds_d, rd_cmds_p, peak_wr, peak_rd, held_raw, held_war);
+        $display("TIME %0d cycles, %0d lines moved (%0d writes + %0d reads): %0.2f cyc/line, %0.0f MB/s at 100 MHz",
+                 t1 - t0, wr_cmds + rd_cmds_d + rd_cmds_p, wr_cmds, rd_cmds_d + rd_cmds_p,
+                 1.0 * (t1 - t0) / (wr_cmds + rd_cmds_d + rd_cmds_p),
+                 3200.0 * (wr_cmds + rd_cmds_d + rd_cmds_p) / (t1 - t0));
+        if (errors == 0) $display("MIXED TEST PASSED");
+        else $display("MIXED TEST FAILED: %0d errors", errors);
+        $finish;
+    end
